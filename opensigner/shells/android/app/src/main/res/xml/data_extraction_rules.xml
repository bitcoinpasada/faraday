<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device (docs/PLANNING.md §5.3). `allowBackup="false"`
  already refuses cloud backup; these rules say the same thing for the two
  channels API 31 and later run through this file, so the settings file in
  `filesDir` — the one thing the app keeps — is copied neither to a backup
  nor to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
