# The build container for Faraday Companion's release APK
# (docs/COMPANION.md §3, docs/APK-SIGNING.md §9). Everything the APK is
# built with is named here: the base image by digest, and each download by
# the SHA-256 of the file, so a changed file fails the build.
#
#   base image    debian:trixie-slim, the digest it had on 2026-10-12
#   Rust          1.97.0 (rust-toolchain.toml; build.sh refuses another)
#                 with the standard library of aarch64-linux-android and
#                 x86_64-linux-android
#   JDK           Temurin 21.0.12.1+1
#   Android       build-tools 36.0.0, platform android-36 (revision 2),
#                 NDK 29.0.14206865 (r29); the same numbers as
#                 faraday/shells/android/app/build.gradle.kts
#   Gradle        8.14.3, fetched by the wrapper in faraday/shells/android
#                 and checked against distributionSha256Sum in
#                 gradle-wrapper.properties; the libraries and plugins it
#                 resolves are checked against gradle/verification-metadata.xml
#
# Debian's own packages (a C compiler and linker for the build scripts that
# run on the host, curl and unzip for this file) are those of the day the
# image is built; none of them is in the APK. The Android SDK parts are
# the zip files Google publishes, unpacked where the Android Gradle plugin
# looks for them; sdkmanager is not used, so no licence prompt is answered
# here (the SDK's licences apply as ever).
FROM debian:trixie-slim@sha256:918311b7b6c4c6f68b232ba516584925f6c78ad82b6fd534b98979df6438e483

RUN export DEBIAN_FRONTEND=noninteractive && apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils ca-certificates curl gcc libc6-dev unzip xz-utils \
    && apt-get clean && find /var/lib/apt/lists -type f -delete

ARG RUST_VERSION=1.97.0
ARG RUST_SHA256=1cf17e4905b841d4c8e3f76467ac148d55fb3f54bf213c86f0d287a36471d904
ARG RUST_STD_AARCH64_SHA256=eb75fbb2b02bda4402a286dd66644ccaa0d379240bd43fa096d0857386974eff
ARG RUST_STD_X86_64_SHA256=c8a4c0f25a34aa546378ce66cb3a5ff40773654055fe08c9233268df2b3f233a
RUN set -eu; \
    host="rust-${RUST_VERSION}-x86_64-unknown-linux-gnu"; \
    a64="rust-std-${RUST_VERSION}-aarch64-linux-android"; \
    x64="rust-std-${RUST_VERSION}-x86_64-linux-android"; \
    for name in "$host" "$a64" "$x64"; do \
        curl --proto '=https' --tlsv1.2 -fsSL -o "/tmp/$name.tar.xz" \
            "https://static.rust-lang.org/dist/$name.tar.xz"; \
    done; \
    echo "$RUST_SHA256  /tmp/$host.tar.xz" | sha256sum -c -; \
    echo "$RUST_STD_AARCH64_SHA256  /tmp/$a64.tar.xz" | sha256sum -c -; \
    echo "$RUST_STD_X86_64_SHA256  /tmp/$x64.tar.xz" | sha256sum -c -; \
    for name in "$host" "$a64" "$x64"; do \
        tar -C /tmp -xf "/tmp/$name.tar.xz"; \
    done; \
    "/tmp/$host/install.sh" --prefix=/usr/local \
        --components=rustc,cargo,rust-std-x86_64-unknown-linux-gnu; \
    "/tmp/$a64/install.sh" --prefix=/usr/local; \
    "/tmp/$x64/install.sh" --prefix=/usr/local; \
    rm -rf /tmp/rust-*

ARG JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_x64_linux_hotspot_21.0.12.1_1.tar.gz
ARG JDK_SHA256=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94
RUN set -eu; \
    curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/jdk.tar.gz "$JDK_URL"; \
    echo "$JDK_SHA256  /tmp/jdk.tar.gz" | sha256sum -c -; \
    mkdir /opt/jdk-21; \
    tar -C /opt/jdk-21 --strip-components=1 -xzf /tmp/jdk.tar.gz; \
    rm /tmp/jdk.tar.gz

# Google's zip files, each with the SHA-256 of the file (the SHA-1 in
# Google's repository listing matches: 2c1a80dd..., b0b63769..., 87e2bb7e...).
# Each holds one folder, which goes where the SDK's layout keeps that part.
ARG ANDROID_REPO=https://dl.google.com/android/repository
ARG PLATFORM_ZIP=platform-36_r02.zip
ARG PLATFORM_SHA256=37607369a28c5b640b3a7998868d45898ebcb777565a0e85f9acf36f29631d2e
ARG BUILD_TOOLS_ZIP=build-tools_r36_linux.zip
ARG BUILD_TOOLS_SHA256=5d9ac77fb6ff43d9da518a337b4fcf8f9097113df531d99ccefe80ef7ce8250b
ARG NDK_ZIP=android-ndk-r29-linux.zip
ARG NDK_SHA256=4abbbcdc842f3d4879206e9695d52709603e52dd68d3c1fff04b3b5e7a308ecf
RUN set -eu; \
    unpack() { \
        curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/part.zip "$ANDROID_REPO/$1"; \
        echo "$2  /tmp/part.zip" | sha256sum -c -; \
        mkdir /tmp/part; unzip -q /tmp/part.zip -d /tmp/part; \
        [ "$(ls /tmp/part | wc -l)" = 1 ]; \
        mkdir -p "$(dirname "$3")"; \
        mv /tmp/part/* "$3"; \
        rm -rf /tmp/part /tmp/part.zip; \
    }; \
    unpack "$PLATFORM_ZIP" "$PLATFORM_SHA256" /opt/android-sdk/platforms/android-36; \
    unpack "$BUILD_TOOLS_ZIP" "$BUILD_TOOLS_SHA256" /opt/android-sdk/build-tools/36.0.0; \
    unpack "$NDK_ZIP" "$NDK_SHA256" /opt/android-sdk/ndk/29.0.14206865

# Mounted by faraday.just: /src (the checkout, read-only), /out, /build (the
# target directory), /work (the copy Gradle builds in), /cargo (the registry
# cache) and /gradle (Gradle's home).
ENV JAVA_HOME=/opt/jdk-21 \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_NDK_HOME=/opt/android-sdk/ndk/29.0.14206865 \
    CARGO_HOME=/cargo \
    CARGO_TARGET_DIR=/build/target \
    GRADLE_USER_HOME=/gradle \
    PATH=/opt/jdk-21/bin:/opt/android-sdk/build-tools/36.0.0:$PATH \
    TZ=UTC \
    LC_ALL=C
WORKDIR /src
