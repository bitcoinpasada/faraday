# The build container for the Linux apps that are published (the desktop
# app and the hub app, docs/HUB.md §1.2). Debian 11 (bullseye) has glibc
# 2.31, so a binary linked here runs on Ubuntu 20.04 and later, Debian 11
# and later, Fedora 32 and later, and Arch.
#
# The base image is pinned by digest, not by tag: a tag moves with every
# point release. This digest is what debian:bullseye-slim pointed at on
# 2026-10-12. The Rust toolchain is the release named by
# rust-toolchain.toml (build.sh refuses a different one), installed from
# the standalone tarball whose SHA-256 is written here, so a changed
# tarball fails the build. Debian's own packages (the C compiler and
# linker) are bullseye's last versions, from its frozen archive.
FROM debian:bullseye-slim@sha256:70509c95d1857a3704c0a5d92ee2e0adac95f612a9386889d70760bfd7c1ebba

# Bullseye has reached end of life, so its packages are on
# archive.debian.org, which does not change; the mirror's bullseye
# directories no longer carry the security updates.
RUN printf '%s\n' \
        'deb http://archive.debian.org/debian bullseye main' \
        'deb http://archive.debian.org/debian-security bullseye-security main' \
        > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        binutils build-essential ca-certificates curl file git pkg-config xz-utils \
    && apt-get clean && find /var/lib/apt/lists -type f -delete

ARG RUST_VERSION=1.97.0
ARG RUST_SHA256=1cf17e4905b841d4c8e3f76467ac148d55fb3f54bf213c86f0d287a36471d904
RUN set -eu; \
    name="rust-${RUST_VERSION}-x86_64-unknown-linux-gnu"; \
    curl --proto '=https' --tlsv1.2 -fsSL -o "/tmp/$name.tar.xz" \
        "https://static.rust-lang.org/dist/$name.tar.xz"; \
    echo "$RUST_SHA256  /tmp/$name.tar.xz" | sha256sum -c -; \
    tar -C /tmp -xf "/tmp/$name.tar.xz"; \
    "/tmp/$name/install.sh" --prefix=/usr/local \
        --components=rustc,cargo,rust-std-x86_64-unknown-linux-gnu; \
    rm -rf "/tmp/$name" "/tmp/$name.tar.xz"

# Mounted by faraday.just: /src (the checkout, read-only), /out, /build
# (the target directory) and /cargo (the registry cache).
ENV CARGO_HOME=/cargo \
    CARGO_TARGET_DIR=/build/target \
    LC_ALL=C
WORKDIR /src
