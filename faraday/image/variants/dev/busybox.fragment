# The applets the release image takes away, put back so the serial login
# works: getty is started from the dev inittab, login is what it runs, and
# su and passwd are what a session needs to be worth having.
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_SU=y
CONFIG_PASSWD=y
CONFIG_SULOGIN=y

# dmesg, which the app runs for the boot report it keeps on the boot
# stick: the kernel log, then the shell's inventory, written at boot and
# every 30 seconds (faraday/shells/stick/src/bootreport.rs). A laptop has
# no serial port anybody can reach, so that file is the only way a boot
# that went wrong says what it did. The dev inittab opens the kernel log
# to the app's user for it; the release image has neither.
CONFIG_DMESG=y
