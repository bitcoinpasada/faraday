drm/vc4: make the fbdev emulation 32 bits per pixel, red first

Faraday's own change, not from mainline.

The kernel's generic fbdev emulation is set up by vc4 at 16 bits per
pixel, and at 32 bits it picks XRGB8888, blue first in memory. The
shell's frame is RGBA, red first. At 16 bits the shell converted every
pixel to RGB565 on the CPU; at XRGB8888 it would still exchange red and
blue. The planes read XBGR8888 as it is (vc4_plane.c lists it among the
HVS formats), so with that format the shell copies its frame to the
framebuffer as it is.

- vc4 asks for a 32-bit fbdev.
- The generic fbdev picks XBGR8888 where the legacy table gives
  XRGB8888.
- drm_fb_helper_fill_pixel_fmt reports red at bit 0 and blue at bit 16
  for XBGR8888, so the console and the boot logo keep their colours.
- The client's framebuffer is made with drm_mode_addfb2, which takes the
  format. drm_mode_addfb takes only bits and depth and works out
  XRGB8888 from them again, so without this the buffer stays blue first
  and red and blue show exchanged on every screen.

The second and fourth changes reach every driver that uses the generic
fbdev emulation or a DRM client; vc4 is the only DRM driver this board
builds. A format the legacy table gives comes out the same either way.

--- a/drivers/gpu/drm/drm_client.c
+++ b/drivers/gpu/drm/drm_client.c
@@ -389,19 +389,16 @@
 				   u32 width, u32 height, u32 format)
 {
 	struct drm_client_dev *client = buffer->client;
-	struct drm_mode_fb_cmd fb_req = { };
-	const struct drm_format_info *info;
+	struct drm_mode_fb_cmd2 fb_req = { };
 	int ret;
 
-	info = drm_format_info(format);
-	fb_req.bpp = drm_format_info_bpp(info, 0);
-	fb_req.depth = info->depth;
 	fb_req.width = width;
 	fb_req.height = height;
-	fb_req.handle = buffer->handle;
-	fb_req.pitch = buffer->pitch;
+	fb_req.pixel_format = format;
+	fb_req.handles[0] = buffer->handle;
+	fb_req.pitches[0] = buffer->pitch;
 
-	ret = drm_mode_addfb(client->dev, &fb_req, client->file);
+	ret = drm_mode_addfb2(client->dev, &fb_req, client->file);
 	if (ret)
 		return ret;
 
--- a/drivers/gpu/drm/drm_fb_helper.c
+++ b/drivers/gpu/drm/drm_fb_helper.c
@@ -1341,6 +1341,10 @@
 		var->red.offset = 16;
 		var->green.offset = 8;
 		var->blue.offset = 0;
+		if (format->format == DRM_FORMAT_XBGR8888) {
+			var->red.offset = 0;
+			var->blue.offset = 16;
+		}
 		var->red.length = 8;
 		var->green.length = 8;
 		var->blue.length = 8;
@@ -2451,6 +2455,9 @@
 		    sizes->surface_bpp);

 	format = drm_mode_legacy_fb_format(sizes->surface_bpp, sizes->surface_depth);
+	/* Red first in memory, which is the order the planes read. */
+	if (format == DRM_FORMAT_XRGB8888)
+		format = DRM_FORMAT_XBGR8888;
 	buffer = drm_client_framebuffer_create(client, sizes->surface_width,
 					       sizes->surface_height, format);
 	if (IS_ERR(buffer))
--- a/drivers/gpu/drm/vc4/vc4_drv.c
+++ b/drivers/gpu/drm/vc4/vc4_drv.c
@@ -416,7 +416,7 @@
 	if (ret < 0)
 		goto unbind_all;

-	drm_fbdev_generic_setup(drm, 16);
+	drm_fbdev_generic_setup(drm, 32);

 	return 0;

