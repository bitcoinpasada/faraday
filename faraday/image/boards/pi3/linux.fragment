# Kernel configuration for the Raspberry Pi 3B/3B+: the SoC's DMA engine,
# its serial port, and the legacy camera stack.

# ---- console ----
# The kernel console is the PL011 on the GPIO header, which disable-bt in
# config.txt frees for serial0.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ---- DMA ----
# The SoC's drivers use its DMA channels. The Pi defconfig has these.
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y
CONFIG_DMA_BCM2708=y

# ---- camera, legacy stack ----
# start_x.elf runs the camera in the GPU; bcm2835-camera talks to it over
# VCHIQ/MMAL and publishes the sensor as a plain V4L2 device, which is what
# faraday-v4l2 opens. This supports the OV5647 and the IMX219; the v3
# module is not supported because it needs libcamera. The sensor is
# addressed over the SoC's hardware i2c controller.
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_MEDIA_SUPPORT=y
# The filter narrows the media menu to one use. It has to be on: with it
# off, every media type defaults to y and DVB_CORE, which has no prompt
# and follows digital TV, cannot be turned off at all.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
CONFIG_VIDEO_DEV=y
CONFIG_VIDEOBUF2_VMALLOC=y
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_BCM2835_VCHIQ=y
CONFIG_BCM2835_VCHIQ_MMAL=y
CONFIG_VIDEO_BCM2835=y

# ---- what the SoC needs, named because nothing else names it ----
# With the defconfig's modules dropped (external/external.mk) a driver is
# on this board only if a fragment says so. Every line below answers a
# `compatible` string in bcm2710-rpi-3-b-plus.dtb; `strings` on the built
# DTB is where the list comes from, not a guess.

# brcm,bcm2835-gpio and the pin groups every other on-SoC driver takes
# its pins from.
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_BCM2835=y

# brcm,bcm2835-cprman, and the clocks the firmware owns.
CONFIG_COMMON_CLK=y
CONFIG_CLK_BCM2835=y
CONFIG_CLK_RASPBERRYPI=y

# brcm,bcm2835-mbox and raspberrypi,bcm2835-firmware. The framebuffer,
# the clocks and the power domains all go through the mailbox; what is
# not built is the userspace door to it, /dev/vcio (common fragment).
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y

# brcm,bcm2835-pm and the firmware power domains. The USB controller and
# the camera sit behind them, so a kernel without these has neither.
CONFIG_BCM2835_POWER=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_RESET_CONTROLLER=y

# brcm,bcm2835-pm-wdt. This is the poweroff path: bcm2835_wdt takes
# pm_power_off, and init's `poweroff -f` after the app exits is what
# powers the board down. Nothing opens /dev/watchdog.
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# brcm,bcm2835-rng, the SoC's hardware generator, which feeds the pool
# /dev/random draws the session's seed from.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_BCM2835=y

# ---- the CPU's clock ----
# The Pi defconfig's default governor is powersave, which holds the
# cores at 600 MHz of 1400: every frame took more than twice as long.
# schedutil raises the clock while frames are drawn and lowers it after,
# and the app raises the lowest clock while something moves
# (docs/MOTION.md §3.2). The firmware still lowers it when the SoC runs
# hot or the supply sags.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE is not set

# ---- the card ----
# brcm,bcm2835-sdhost and brcm,bcm2835-mmc are the two controllers the
# Pi 3 boots and reads the exchange partition from. sdhci-iproc
# (brcm,bcm2835-sdhci) is the SDIO controller the Wi-Fi chip is on, and
# config.txt disables the radio, so it is not built.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835_SDHOST=y
CONFIG_MMC_BCM2835_MMC=y
CONFIG_MMC_BCM2835_DMA=y
# CONFIG_MMC_SDHCI_IPROC is not set

# ---- USB: a webcam, keyboards and mice, touchscreens and sticks ----
# brcm,bcm2708-usb is the board's host controller. It is kept on purpose,
# with the USB video class on top, so a plain USB webcam appears as a
# /dev/video* the shell can open — it takes the first one. The USB HID
# transport and USB mass storage are below; gadget mode and the network
# adapters that went with CONFIG_NET are out in the common fragment.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DWCOTG=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y

# ---- what this board does not have ----
# The common fragment holds what no Faraday image builds. The Pi's own is
# below; the stick board builds HID and USB storage as the Pi does.

# The firmware mailbox from userspace, /dev/vcio. This is the path
# `vcgencmd otp_set` takes to burn the SoC's one-time-programmable rows:
# 8 customer rows, 256 bits, exactly a 24-word seed, readable afterwards
# with `vcgencmd otp_dump` on any card, and not wipeable at all.
# CONFIG_BCM_VCIO is not set

# ---- three things that stay on, each for one driver ----
# CONFIG_PM, because the Raspberry Pi firmware power-domain driver depends
# on it and both the USB controller and the camera sit behind those
# domains; SUSPEND and HIBERNATION are out in the common fragment.
# CONFIG_WATCHDOG, because BCM2835_WDT owns pm_power_off on a Pi and
# `poweroff -f` — init's next line after the app exits — does nothing
# without it. CONFIG_STAGING, because the legacy camera lives there.

# ---- Faraday: no filesystem on the card is parsed by the kernel ----
# (docs/history/PLAN.md §4.2.) faraday-disk reads the card's data partition, unprivileged,
# with its own FAT code; common/linux.fragment turns vfat on for upstream's
# mount, and these lines turn it off again. MBR partitions stay, so the
# card's partitions are their own nodes and the whole card is never handed
# out.
# CONFIG_FAT_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# USB is kept for a webcam (docs/history/PLAN.md §4.6): no printer, no traffic monitor.
# CONFIG_USB_PRINTER is not set
# CONFIG_USB_MON is not set

# ---- Faraday: no core dumps (docs/history/PLAN.md §5.3) ----
# A crashing app would write its memory, keys included, to a file. The
# core limit is 0 by default; this takes the feature out of the kernel so
# nothing in userspace can raise it. The prompt needs EXPERT.
CONFIG_EXPERT=y
# CONFIG_COREDUMP is not set

# ---- what the Pi adds to the common fragment (docs/IMAGES.md §1) ----
# A screen driven through the kernel (HDMI, and the 2.8-inch's DPI
# panel), USB keyboards, mice and touchscreens, and USB sticks. Every
# addition is checked by this directory's kernel.required and
# kernel.forbidden.

# ---- the display: vc4's display side, through DRM ----
# The HVS, the pixel valves, the HDMI encoder and the DSI hosts are one
# driver, vc4, and the kernel source is the board's as it is: Faraday
# carries no kernel patch of its own (F153). vc4 also binds the GPU's 3D
# block, V3D, and gives the device a render node, /dev/dri/renderD128,
# beside /dev/dri/card0. Only the app opens a display node, and it opens
# /dev/fb0, DRM's framebuffer emulation; common/rootfs-overlay/etc/mdev.conf
# gives both DRM nodes to root alone (0600), and the only root processes
# after boot are init and its two shell loops, which open neither
# (docs/SECURITY-MODEL.md, "When root is used").
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_FBDEV_EMULATION=y
# HDMI-CEC: a monitor's remote-control bus, which reaches into the device.
# CONFIG_DRM_VC4_HDMI_CEC is not set
# CONFIG_CEC_CORE is not set
# kcmp(), which DRM selects for Mesa's sake. This build allows it (F153):
# it only says whether two processes share a kernel object, and only for
# processes that pass ptrace's read check against the caller; each of the
# device's processes runs as a user of its own, so the app can compare
# only its own. Every other image forbids it in its own kernel.forbidden.
CONFIG_KCMP=y
# The rest of DRM is for other hardware, or for a desktop.
# CONFIG_DRM_V3D is not set
# CONFIG_DRM_DP_AUX_CHARDEV is not set
# CONFIG_DRM_LOAD_EDID_FIRMWARE is not set
# CONFIG_DRM_LEGACY is not set
# CONFIG_DRM_VC4_KUNIT_TEST is not set

# ---- sound: only because vc4 depends on it ----
# DRM_VC4 depends on SND and SND_SOC, since its HDMI encoder can carry
# audio (drivers/gpu/drm/vc4/Kconfig), so the sound core is built. No
# sound driver is: the HDMI encoder's audio is the only one, and the
# panel's config.txt turns it off in the device tree (vc4-kms-v3d's
# noaudio), so no sound card is registered.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_ARM is not set
# CONFIG_SND_SPI is not set
# CONFIG_SND_USB is not set
# CONFIG_SND_BCM2835 is not set
# CONFIG_SND_BCM2835_SOC_I2S is not set
# CONFIG_SND_SEQUENCER is not set
# CONFIG_SND_OSSEMUL is not set
# CONFIG_SND_PCM_OSS is not set
# CONFIG_SND_SUPPORT_OLD_API is not set
# CONFIG_SND_VERBOSE_PROCFS is not set
# CONFIG_SND_SOC_ALL_CODECS is not set

# ---- USB input: HID, as on the PC ----
# The generic HID driver for keyboards and mice, the USB transport, and
# hid-multitouch for a USB touchscreen. The common fragment turns HID off;
# these lines turn it on.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
# Raw HID access. Input reaches the shell through evdev, and nothing reads
# a HID report itself.
# CONFIG_HIDRAW is not set
# CONFIG_USB_HIDDEV is not set
# The vendor HID drivers. Each binds to a vendor and product ID any USB
# device can claim and parses that device's reports with its own code.
# HID_GENERIC and HID_MULTITOUCH cover keyboards, mice and touchscreens; a
# vendor's extra keys are what is lost.
# CONFIG_HID_A4TECH is not set
# CONFIG_HID_APPLE is not set
# CONFIG_HID_BELKIN is not set
# CONFIG_HID_CHERRY is not set
# CONFIG_HID_CHICONY is not set
# CONFIG_HID_CYPRESS is not set
# CONFIG_HID_EZKEY is not set
# CONFIG_HID_GYRATION is not set
# CONFIG_HID_ITE is not set
# CONFIG_HID_KENSINGTON is not set
# CONFIG_HID_LOGITECH is not set
# CONFIG_HID_REDRAGON is not set
# CONFIG_HID_MICROSOFT is not set
# CONFIG_HID_MONTEREY is not set
# CONFIG_HID_NTRIG is not set
# CONFIG_HID_PANTHERLORD is not set
# CONFIG_HID_PETALYNX is not set
# CONFIG_HID_SAMSUNG is not set
# CONFIG_HID_SONY is not set
# CONFIG_HID_SUNPLUS is not set
# CONFIG_HID_TOPSEED is not set
# CONFIG_HID_PID is not set

# ---- USB storage: a stick, through faraday-grant and faraday-disk ----
# A USB mass-storage device is a SCSI disk. Its partitions reach the disk
# process only through faraday-grant, as on the PC: one at a time, never a
# boot partition, and no filesystem driver (this fragment keeps FAT
# out). GPT, beside the board's MBR, because most sticks carry one.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_EFI_PARTITION=y
# The SAS, iSCSI, fibre-channel and RAID controllers a disk can be behind.
# CONFIG_SCSI_LOWLEVEL is not set
# The SCSI CD-ROM driver binds to any USB device that presents a CD-ROM
# and parses what it sends.
# CONFIG_BLK_DEV_SR is not set
# CONFIG_CHR_DEV_SG is not set
# CONFIG_SCSI_PROC_FS is not set
# CONFIG_USB_UAS is not set

# ---- screens found at boot: overlays loaded while the kernel runs ----
# The boot script (common/rootfs-overlay/etc/init.d/screen) loads the
# screen's device-tree overlay from the initramfs through configfs
# (docs/IMAGES.md §3.3). Every option below was read from the Kconfig of the
# pinned Raspberry Pi kernel, not from memory: OF_CONFIGFS (drivers/of/Kconfig)
# selects CONFIGFS_FS and OF_OVERLAY, and OF_OVERLAY selects OF_DYNAMIC,
# OF_FLATTREE and OF_RESOLVE.
CONFIG_OF_OVERLAY=y
CONFIG_CONFIGFS_FS=y
CONFIG_OF_CONFIGFS=y

# The 2.8-inch's DPI panel: vc4-kms-dpi-generic declares a `panel-dpi` node,
# which panel-simple drives. DRM_PANEL_SIMPLE depends on OF, PM and
# BACKLIGHT_CLASS_DEVICE (drivers/gpu/drm/panel/Kconfig).
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# Waveshare's touch overlay declares the panel's backlight as a
# gpio-backlight node (GPIO 18, on).
CONFIG_BACKLIGHT_GPIO=y

# The 3B+'s HDMI hotplug line is behind the firmware's GPIO expander
# (depends on OF_GPIO and RASPBERRYPI_FIRMWARE): without it vc4 cannot say
# whether a monitor is connected, which is the boot script's first check.
CONFIG_GPIO_RASPBERRYPI_EXP=y

# The touch controller on the bit-banged I2C bus the touch overlay declares
# (I2C_GPIO selects I2C_ALGOBIT; TOUCHSCREEN_GOODIX depends on I2C and
# GPIOLIB), and the SoC's hardware I2C, whose HDMI DDC bus carries the EDID.
CONFIG_I2C_GPIO=y
CONFIG_I2C_BCM2835=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y

# ---- the firmware's framebuffer goes ----
# DRM's framebuffer emulation is /dev/fb0 on every screen; the firmware's
# driver would compete with it, and the DPI panel is vc4's now.
# CONFIG_FB_BCM2708 is not set
