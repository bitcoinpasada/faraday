# Raspberry Pi 3B/3B+/Zero 2 W: the architecture, the kernel and the firmware.
#
# Buildroot's raspberrypi3_defconfig is the starting point: the same 32-bit
# armv7 target `just faraday-pi-bin` builds for, the Raspberry Pi kernel
# and firmware pinned below. The Zero 2 W is the same BCM2710, so
# it needs only its device trees, which come from board.conf's DTBS.

# armv7 hard-float, Cortex-A53. Matches armv7-unknown-linux-gnueabihf.
BR2_arm=y
BR2_cortex_a53=y
BR2_ARM_FPU_NEON_VFPV4=y

# Buildroot 2024.02 offers no 6.18 choice; 6_6 is the highest it has.
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y

# ---- kernel ----
# Raspberry Pi's 6.18 tree (6.18.59), its bcm2709 configuration (32-bit),
# and our fragments on top.
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,9b488bc7a1e9b61713082f3e6c4361988d62f77b)/linux-9b488bc7a1e9b61713082f3e6c4361988d62f77b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2709"
# The kernel tarball's sha256, which build.sh checks after the download.
# Buildroot has no hash of its own for a tarball that is not one of the
# versions its linux.hash lists, and this is not one, so without this line
# nothing checks what was fetched.
# KERNEL_SHA256 01eb0496c85b79c7a1c018241b09b63893259975672a2a12b9c44cf33ab26cb7
# One change to the EDID read (docs/IMAGES.md §3.2): without it a screen
# whose EDID has three or more blocks shows nothing on most boots. /image is
# this tree as build.sh sees it.
BR2_LINUX_KERNEL_PATCH="/image/boards/pi3/linux-patches"

BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y

# ---- firmware ----
# PI_X is the camera variant: start_x.elf and fixup_x.dat, which config.txt
# selects and start_x=1 turns on.
# Buildroot 2024.02 fixes the package's version and has no option for
# another, so the version is passed on make's command line (build.sh reads
# the next line), and the tarball's hash is in BR2_GLOBAL_PATCH_DIR, where
# Buildroot looks for a hash file by version and checks the download
# against it. This commit's boot/ is built from the kernel above
# (extra/git_hash), so the overlays on the card match its device trees.
# RPI_FIRMWARE_VERSION ab5c7f86283ceb58b7adb269cae1d16092a31bf6
BR2_GLOBAL_PATCH_DIR="/image/boards/pi3/buildroot-global"
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI_X=y
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
