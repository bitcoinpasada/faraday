# The stick can be sda on one machine and sdb on the next, so rcS asks
# which node carries the partition labelled FARADAYDATA instead of naming one.
# `findfs` is the applet that answers, and it reads the label out of the
# FAT superblock through BusyBox's own volume_id.
CONFIG_FINDFS=y
CONFIG_VOLUMEID=y
CONFIG_FEATURE_VOLUMEID_FAT=y
