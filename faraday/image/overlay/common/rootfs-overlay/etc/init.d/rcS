#!/bin/sh
# Faraday's rcS: upstream's (opensigner/shells/pi/image/common/
# rootfs-overlay/etc/init.d/rcS at c418768) without a single mount of
# storage (PLAN.md §4.1, §4.3). The kernel has no FAT driver; a stick's
# partitions reach the disk process only through faraday-grant.
#
# The kernel mounts devtmpfs on /dev itself (CONFIG_DEVTMPFS_MOUNT), and
# `mdev -s` applies /etc/mdev.conf's owners once. A stick's partition node
# stays root's, mode 0600 or 0660, until faraday-grant decides.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
/sbin/mdev -s

# USB interfaces (PLAN.md §4.6): no root hub authorises an interface by
# itself from here on. usbcore.authorized_default=2 already keeps every
# device off a hard-wired port unauthorised; faraday-grant authorises
# those devices and then their interfaces one class at a time.
for f in /sys/bus/usb/devices/usb*/interface_authorized_default; do
    [ -f "$f" ] && echo 0 > "$f"
done

# The clean marker's directory (PLAN.md §5.1): the app writes the marker
# while it is clean and removes it when it is not; faraday-grant reads it.
mkdir -p /run/faraday-clean
chown opensigner:opensigner /run/faraday-clean
chmod 0755 /run/faraday-clean

# The disk process's two pipes: requests from the app's shell, answers to
# it. The disk process owns them and the app's group may use them; nobody
# else can.
mkdir -p /run/faraday-disk
mkfifo -m 0660 /run/faraday-disk/requests /run/faraday-disk/responses
chown ofdisk:opensigner /run/faraday-disk /run/faraday-disk/requests \
    /run/faraday-disk/responses
chmod 0750 /run/faraday-disk

# The grant helper starts as root and gives up all but CAP_CHOWN before it
# reads anything. It is started once: if it dies, no stick is handed out
# again, which fails closed.
/usr/bin/faraday-grant 2>/dev/kmsg &

# Both helpers say what they say in the kernel log: the console this
# script runs on refuses writes once it has ended.
#
# The disk process, unprivileged, started again if it ends. init cannot
# do this itself: its `respawn` entries start only after the app loop, a
# `wait` entry, has ended.
(
    while :; do
        /bin/setpriv --nnp /usr/bin/setuidgid ofdisk /usr/bin/faraday-disk \
            /run/faraday-disk/requests /run/faraday-disk/responses 2>/dev/kmsg
        sleep 1
    done
) &
