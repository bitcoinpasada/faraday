# Kernel configuration for a PC booted from an OpenSigner USB stick.
#
# The starting point is x86_64_defconfig with its `=m` lines deleted and
# CONFIG_MODULES turned off in the unpacked tree (external/external.mk,
# PLANNING.md 16.93), then common/linux.fragment. What is left to say is
# here, with a reason per line: this is a laptop, so it has firmware that
# runs an EFI application, a framebuffer that is already on, a keyboard, a
# touchpad, USB ports and a disk to boot from — none of which the Pi has
# and all of which the common fragment therefore says nothing about.

# Kconfig's "expert" level, which every ARM defconfig sets and no x86 one
# does. It builds nothing: what it does is give a prompt to symbols that
# otherwise have none, and a symbol with no prompt cannot be turned off.
# CONFIG_NAMESPACES and CONFIG_VGA_CONSOLE below are both in that
# position — they are `default y` with the prompt hidden unless this is on.
CONFIG_EXPERT=y

# ---- boot ----
# The firmware runs one file, EFI/BOOT/BOOTX64.EFI, and that file is this
# kernel: EFI_STUB makes bzImage a PE/COFF application with its own
# loader. There is no bootloader, no shim and no second stage.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# CONFIG_CMDLINE_BOOL, CONFIG_CMDLINE and CONFIG_CMDLINE_OVERRIDE are
# generated by build.sh from the parts' cmdline.txt files and merged after
# this file. Nothing passes this kernel a command line, and OVERRIDE means
# that anything which tried would be ignored.

# Every laptop sold this decade has more than one core, and a kernel
# without SMP runs the app on one of them.
CONFIG_SMP=y

# ACPI is how a PC describes itself: it is what powers the machine off
# when the app exits, and it is what enumerates the i8042 controller the
# built-in keyboard and touchpad are behind and the i2c bus a newer
# touchpad is on.
CONFIG_ACPI=y

# The USB host controllers, and on most machines the display, are PCI
# devices.
CONFIG_PCI=y
# PCIEPORTBUS is the PCIe port service driver: hotplug, power management,
# AER and the rest. Nothing here is hot-plugged (PLANNING.md 16.94) and
# the controllers are found by enumeration without it.
# CONFIG_PCIEPORTBUS is not set

# The stick is GPT, so the kernel needs the GPT parser to find the second
# partition at all.
CONFIG_EFI_PARTITION=y

# ---- display ----
# The firmware leaves a framebuffer running at a mode it chose, and hands
# its address, size, depth and stride over. sysfb turns that hand-over
# into a platform device and one of these two drivers publishes it as
# /dev/fb0 with the same numbers in sysfs, which is what the shell reads
# when it is given no --size. Both are built because which device sysfb
# registers depends on the machine.
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_EFI=y

# The legacy VGA text console. A machine booted through UEFI is in a
# graphics mode from the firmware onwards and never has one.
# CONFIG_VGA_CONSOLE is not set

# ---- input ----
# A laptop has a keyboard and a touchpad behind the i8042 controller, or a
# touchpad on an i2c bus, or both; and a USB port that a keyboard, a mouse
# or a touchscreen may be plugged into. The shell classifies whatever it
# finds from sysfs and reads it through evdev (PLANNING.md 16.94).
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# The i8042 controller, the AT keyboard behind it, and the PS/2 mouse
# protocol every built-in touchpad speaks through it.
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y

# A touchpad on an i2c bus instead: I2C_HID_ACPI is the transport, the
# Designware controller is the bus on nearly every Intel and AMD laptop,
# and ACPI is what says which pins and which address.
CONFIG_I2C=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
# The Designware driver depends on a clock provider when ACPI is on, and
# x86 builds none by default.
CONFIG_COMMON_CLK=y

# The HID layer itself: the generic driver for keyboards and mice, the
# USB transport, and hid-multitouch, which is what a laptop touchpad or a
# touchscreen reports through.
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y

# ---- the buses a laptop's own touchpad is on ----
# I2C_HID_ACPI above is the protocol; what was missing is the controller
# under it. On Skylake and later the I2C controllers are PCI devices
# behind Intel's Low Power Subsystem driver, not ACPI platform devices, so
# a machine like a Dell XPS 9360 enumerated no bus at all and its touchpad
# never appeared.
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_DESIGNWARE_BAYTRAIL=y

# The interrupt line of an i2c touchpad is a pin on the chipset's GPIO
# controller, named by ACPI. Without a pin controller for that chipset the
# device is found and never interrupts. Each of these drivers is a pin
# table and a few hundred lines; a laptop is one of them and there is no
# way to know which from here, so all of them are built.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_LYNXPOINT=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_EMMITSBURG=y
CONFIG_PINCTRL_LAKEFIELD=y
CONFIG_PINCTRL_DENVERTON=y
CONFIG_PINCTRL_LEWISBURG=y
# The same two parts for an AMD laptop: the chipset's GPIO controller, and
# the controller its i2c touchpad is on.
CONFIG_PINCTRL_AMD=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_I2C_AMD_MP2=y
# GPIO_ACPI is the path that turns an ACPI GPIO interrupt resource into a
# usable line. It has no prompt: it is `default y` once GPIOLIB is built,
# which the pin controllers above select. kernel.required is what checks
# it came out on.

# A pad that speaks PS/2 rather than HID: MOUSE_PS2 above carries the
# generic protocol, and these are the vendor extensions a pad needs before
# it reports more than a three-button mouse's worth of motion. The two
# SMBUS options are the pads that speak PS/2 until they are told to move
# to the SMBus, where RMI4 is what talks to them; I2C_I801 is the SMBus
# controller on every Intel chipset.
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_BYD=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_SMB=y
CONFIG_I2C_I801=y
# RMI4 carries no function driver by default, and a core with none reports
# nothing. F11 and F12 are the two-dimensional pointing functions a pad
# reports through; F30 is the button under a clickpad. F34 reflashes the
# device's firmware from a blob and is not built.
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
# CONFIG_RMI4_F34 is not set

# Touchscreens, HID ones only. A panel wired to an i2c or SPI controller
# of its own needs a driver named for that controller; nothing on a laptop
# is, and a driver for a part this device does not have is not built.
CONFIG_INPUT_TOUCHSCREEN=y

# ---- USB ----
# The stick is a USB disk and the machine boots from it, so the host
# controllers, the mass-storage driver and the SCSI disk above it are all
# needed to read the exchange partition. xHCI is every port made this
# decade; EHCI is the older internal ports some machines still put the
# keyboard controller or a card reader behind.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# ---- the machine's own disk ----
# Nothing in this image mounts the laptop's internal disk, and none of
# these drivers is built, so the kernel does not see it: there is no
# block device for it, and nothing can read it, write it or mount it by
# label. SCSI and BLK_DEV_SD above stay, because that is the USB stick's
# own path — a USB mass-storage device is a SCSI disk.
#
# x86_64_defconfig builds ATA, SATA_AHCI and ATA_PIIX in; this turns the
# whole subsystem off, which takes those two controllers with it.
# CONFIG_ATA is not set
# NVMe, which is what a disk in a machine made this decade is on.
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_CORE is not set
# eMMC and the SD card reader: a disk and a card this device does not read.
# CONFIG_MMC is not set
# The SCSI transports and controllers: fibre channel, iSCSI, SAS, and the
# RAID cards. A USB disk is behind none of them, and a disk on one of them
# is a disk this kernel does not see.
# CONFIG_SCSI_LOWLEVEL is not set

# ---- camera ----
# A plain USB webcam appears as a /dev/video* and the shell — which takes
# the first one — scans with it. The media filter is on with cameras the
# only type selected, because with it off every media type defaults to y
# and DVB_CORE, which has no prompt, cannot be turned off at all
# (PLANNING.md 16.93). A camera on a MIPI CSI-2 lane, which is what most
# laptop webcams made after 2020 are, needs a per-platform driver and
# userspace this image does not have; the README says so.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
CONFIG_VIDEO_DEV=y
CONFIG_VIDEOBUF2_VMALLOC=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y

# ---- console ----
# The first 16550 serial port. The release image's command line names no
# console at all, so nothing is printed anywhere; the dev variant's names
# ttyS0, which is the port QEMU gives it and the header a laptop hides
# under its bottom cover.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y

# ---- the IOMMU is on before anything is plugged in ----
# A PCIe device can read all of memory unless something stops it, and a
# laptop's ports are PCIe: a Thunderbolt or USB4 port is a PCIe slot on
# the outside of the case. Both IOMMUs are built, both are on from boot
# rather than on request, and mappings are torn down synchronously
# (DMA_STRICT) rather than batched, so a device cannot read a page it was
# finished with.
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y

# The Thunderbolt/USB4 driver itself is what makes a PCIe tunnel over
# those ports work. Without it the port carries USB and DisplayPort and
# nothing that speaks PCIe, which is the whole of what this device wants
# from it.
# CONFIG_THUNDERBOLT is not set

# ---- entropy ----
# The CPU's RDRAND and the firmware's seed are both mixed into the pool;
# what these two options change is whether the kernel *credits* them, that
# is, whether it will hand out randomness on their word alone before
# anything else has been measured. A generator inside the CPU cannot be
# examined and a seed from the firmware was chosen by the firmware, so
# neither is credited here. The kernel still mixes both in.
# CONFIG_RANDOM_TRUST_CPU is not set
# CONFIG_RANDOM_TRUST_BOOTLOADER is not set

# ---- power ----
# The machine is on or it is off. Runtime power management is off with
# SUSPEND and HIBERNATION (common/linux.fragment): a device that holds a
# seed in DRAM has no state to save to disk and no reason to be asleep
# with the screen on someone's desk. ACPI still powers it off, which is
# init's `poweroff -f` after the app exits.
# CONFIG_PM is not set

# ---- what a PC has that this device does not want ----
# CONFIG_MICROCODE cannot be turned off: it is `def_bool y` with no
# prompt, on any kernel built for an Intel or an AMD CPU. What it does at
# boot is look inside the initramfs for kernel/x86/microcode/*.bin, and
# this image has no such file and no firmware blob of any kind, so the
# loader finds nothing and the CPU runs the microcode its own flash
# holds. MICROCODE_LATE_LOADING, which is a prompt and is off, is the
# other half. PLANNING.md 16.95 records shipping a blob as a decision to
# revisit: the other side of it is a CPU running with known errata
# unpatched.

# /dev/cpu/*/msr and /dev/cpu/*/cpuid: the model-specific registers as a
# file to read and write. DEVMEM is out in the common fragment for the
# same reason.
# CONFIG_X86_MSR is not set
# CONFIG_X86_CPUID is not set

# efivarfs is the firmware's own variable store, mounted and writable. The
# stick changes nothing about the machine it is plugged into, and a boot
# entry written from here would be exactly that.
# CONFIG_EFIVAR_FS is not set

# Paravirtualised guest support: KVM, Hyper-V, Xen and VMware. This is a
# kernel for a laptop. It boots in QEMU as a plain emulated PC, which is
# what tools/stick-test.py runs, and that is the same path a laptop takes.
# CONFIG_HYPERVISOR_GUEST is not set

# ---- Faraday: no filesystem on a stick is parsed by the kernel ----
# (PLAN.md §4.2.) The stick's partitions are read by faraday-disk, an
# unprivileged process with its own FAT code, never mounted. This board
# fragment comes after common/linux.fragment, which turns vfat on for
# upstream's exchange partition; these lines turn it, and every other
# filesystem a stick could carry, off again.
# CONFIG_FAT_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# Partitions appear as their own nodes, so a whole disk is never what is
# handed out (§4.3): GPT for the stick and most others, MBR for the rest.
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# ---- Faraday: USB drivers for storage, HID, video and hubs only ----
# (PLAN.md §4.6.) A printer and the USB traffic monitor have no place on a
# device that signs: usbmon would show every key a USB keyboard sends.
# CONFIG_USB_PRINTER is not set
# CONFIG_USB_MON is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_ACM is not set

# ---- Faraday: no core dumps (PLAN.md §5.3) ----
# A crashing app would write its memory, keys included, to a file. The
# core limit is 0 by default; this takes the feature out of the kernel so
# nothing in userspace can raise it. The prompt needs EXPERT, set above.
# CONFIG_COREDUMP is not set

# ---- hardening only x86 has (PLANNING.md 16.140) ----
# Kernel heap caches split by call site, list corruption checks, and a
# random offset for the kernel stack on every system call, on by default
# rather than on request. The Pi's kernel has none of the three.
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_LIST_HARDENED=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# The 32-bit system call table and the interfaces only 16-bit or
# port-banging programs use. The shell is a static 64-bit musl binary.
# CONFIG_IA32_EMULATION is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_X86_16BIT is not set
# CONFIG_X86_IOPL_IOPERM is not set
# /dev/port, /dev/mem's sibling for I/O ports; DEVMEM is out already.
# CONFIG_DEVPORT is not set
# The vsyscall page, which no static musl binary calls.
CONFIG_LEGACY_VSYSCALL_NONE=y
# Pushing characters into a terminal's input queue from a process.
# CONFIG_LEGACY_TIOCSTI is not set
# Raw HID access. Keyboards, touchpads and mice reach the shell through
# evdev, and nothing reads a HID report itself.
# CONFIG_HIDRAW is not set
# CONFIG_USB_HIDDEV is not set

# ---- drivers x86_64_defconfig brought in ----
# virtio: a PCIe device can present virtio IDs, and VIRTIO_BLK is a block
# device on a machine whose only storage is the stick. QEMU boots the
# stick as a USB disk on xHCI and uses no virtio (tools/stick-qemu.py).
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_CONSOLE is not set
# The SCSI CD-ROM driver. ISO9660 is not built, but the driver still binds
# to any USB device that presents a CD-ROM and parses what it sends, and
# such devices are common, malicious ones included.
# CONFIG_BLK_DEV_SR is not set
# The vendor HID drivers. Each binds to a vendor and product ID any USB
# device can claim and parses that device's reports with its own code.
# HID_GENERIC and HID_MULTITOUCH cover keyboards, mice and touchpads; a
# vendor's extra keys are what is lost.
# CONFIG_HID_A4TECH is not set
# CONFIG_HID_APPLE is not set
# CONFIG_HID_BELKIN is not set
# CONFIG_HID_CHERRY is not set
# CONFIG_HID_CHICONY is not set
# CONFIG_HID_CYPRESS is not set
# CONFIG_HID_EZKEY is not set
# CONFIG_HID_GYRATION is not set
# CONFIG_HID_ITE is not set
# CONFIG_HID_KENSINGTON is not set
# CONFIG_HID_LOGITECH is not set
# CONFIG_HID_REDRAGON is not set
# CONFIG_HID_MICROSOFT is not set
# CONFIG_HID_MONTEREY is not set
# CONFIG_HID_NTRIG is not set
# CONFIG_HID_PANTHERLORD is not set
# CONFIG_HID_PETALYNX is not set
# CONFIG_HID_SAMSUNG is not set
# CONFIG_HID_SONY is not set
# CONFIG_HID_SUNPLUS is not set
# CONFIG_HID_TOPSEED is not set
# CONFIG_HID_PID is not set
# PCI hotplug, for the same reason PCIEPORTBUS is out: nothing here is
# hot-plugged.
# CONFIG_HOTPLUG_PCI is not set
# Replacing ACPI tables or adding SSDTs at boot. With the command line
# built in and the initramfs inside the kernel they have nothing to read,
# and nothing here needs them.
# CONFIG_ACPI_TABLE_UPGRADE is not set
# CONFIG_EFI_CUSTOM_SSDT_OVERLAYS is not set
# The EFI runtime memory map in sysfs, which exists for kexec.
# CONFIG_EFI_RUNTIME_MAP is not set
