# Win32_EncryptableVolume's answers, in the form
# faraday_hub_shell::windows::bitlocker::Recorded reads, made by hand to
# the class's documented methods and return values (`faraday-starter
# --record-bitlocker` on a Windows computer prints the same form, with no
# recovery password in it). The volumes, IDs and keys are made up.
#
# Device encryption's drive with no recovery password yet: one is added,
# and that one is read.
volume \\?\Volume{1b2c3d4e-0000-4000-8000-00000000000c}\ C: type 0 protection 1
call \\?\Volume{1b2c3d4e-0000-4000-8000-00000000000c}\ GetKeyProtectors KeyProtectorType=u32:3 -> 0 VolumeKeyProtectorID=strs:
call \\?\Volume{1b2c3d4e-0000-4000-8000-00000000000c}\ ProtectKeyWithNumericalPassword -> 0 VolumeKeyProtectorID=str:{7B1F2A3D-4C5E-4F60-9BAC-1D2E3F4A5B6C}
call \\?\Volume{1b2c3d4e-0000-4000-8000-00000000000c}\ GetKeyProtectorNumericalPassword VolumeKeyProtectorID=str:{7B1F2A3D-4C5E-4F60-9BAC-1D2E3F4A5B6C} -> 0 NumericalPassword=str:205568-492019-108251-336446-650375-210331-584155-047520
