<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing the Companion keeps leaves the phone (docs/COMPANION.md §7).
  `allowBackup="false"` already refuses cloud backup; these rules say the
  same for the two channels API 31 and later run through this file: every
  domain is excluded from a backup and from a transfer to a new phone.
  Copied from upstream's opensigner/shells/android at d26b84e.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
