<?xml version="1.0" encoding="utf-8"?>
<!--
  Faraday Companion asks for two permissions and nothing else
  (docs/COMPANION.md §6.1). No INTERNET, so the system refuses the app's
  sockets whatever its code does; no storage permission, since documents
  come and go through the system's picker and creator.

  CAMERA is asked for at the first scan, not at install. USE_BIOMETRIC
  opens nothing on its own: it lets the app show the system's unlock
  prompt in front of wallet descriptions (§7), granted
  at install, with no access to any biometric data.

  What the app keeps is in its private storage, encrypted under a Keystore
  key of its own. `allowBackup` is false and `dataExtractionRules`
  excludes every domain, so none of it goes to a cloud backup or to a new
  phone (§7).

  Data leaves only through Share (the provider below, not exported) and
  arrives through the share target (ACTION_SEND), the picker, the camera
  and Paste (§6.3).

  `tools/lint-companion-android.sh` fails `just lint` on any other
  <uses-permission>, on any <uses-library>, on any other provider, service
  or receiver, on an exported provider, and on any intent filter beyond
  the launcher's and SEND's.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- A phone with no camera still runs everything but the scanner. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.FaradayCompanion">

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The share target (§6.3): one file or one text from another
                 app, routed as a scan is. Nothing but SEND. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Share (§6.3): the one file the person pressed Share for, read
             only, from memory. Not exported: another app reads it only
             through the grant the share carries for that file's address. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="app.faradayoffline.companion.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
