# Win32_EncryptableVolume's answers, in the form
# faraday_starter_shell::windows::bitlocker::Recorded reads, recorded with
# `Faraday Starter.exe --record-bitlocker` in the Windows 11 Pro test
# virtual machine (docs/BITLOCKER-ACCEPTANCE.md), after the Starter's
# Suspend. The volumes and the protector ID are that machine's own; no
# recovery password is recorded.
#
# BitLocker suspended on the system drive C:, and the removable FAT
# drive D: not encrypted, unchanged.
# The shell's System.Volume.BitLockerProtection for C: read Some(5).
volume \\?\Volume{5d9db820-57f3-431c-83e2-854229ff0c49}\ C: type 0 protection 0
volume \\?\Volume{c5f6791c-c6e5-11f1-9426-806e6f6e6963}\ D: type 2 protection 0
call \\?\Volume{5d9db820-57f3-431c-83e2-854229ff0c49}\ GetConversionStatus -> 0 ConversionStatus=u32:1
call \\?\Volume{5d9db820-57f3-431c-83e2-854229ff0c49}\ GetSuspendCount -> 0 SuspendCount=u32:0
call \\?\Volume{5d9db820-57f3-431c-83e2-854229ff0c49}\ GetKeyProtectors KeyProtectorType=u32:3 -> 0 VolumeKeyProtectorID=strs:{C6331735-7A7F-4335-B9EB-C24795C97965}
